# Copy to .env and edit. Never commit .env.

# PostgreSQL URL (postgres:// also works)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has special characters, encode them: @ = %40, # = %23, / = %2F, : = %3A, % = %25
# Create the database first (e.g. CREATE DATABASE inventory;)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/inventory

# Optional: login for the whole app (user:password)
# Plain text here, no encoding needed.
# BASIC_AUTH=admin:change-me

# Optional: port (default 5000)
# PORT=5000

# Optional: dev mode, never in production
# FLASK_DEBUG=1