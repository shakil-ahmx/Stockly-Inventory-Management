# Copy to .env and edit. Never commit .env.

# PostgreSQL URL (postgres:// also works)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory

# Optional: login for the whole app (user:password)
# BASIC_AUTH=admin:change-me

# Optional: port (default 5000)
# PORT=5000

# Optional: dev mode, never in production
# FLASK_DEBUG=1